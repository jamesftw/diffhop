# GitHub Personal Access Token used by the localhost proxy to fetch private diffs.
# Generate one at https://github.com/settings/tokens with `repo` scope (classic),
# or a fine-grained token with read-only "Contents" access to the repos you need.
GITHUB_PAT=ghp_replace_me

# Port the proxy listens on. Must match the "Proxy port" field in the extension popup.
PORT=7547
