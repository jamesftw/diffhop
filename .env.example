# Optional. The preferred way to authenticate is `npm run login` (GitHub Device
# Flow — no manual token), which saves a token to ~/.diffhop/token.json.
#
# As a fallback you can set a Personal Access Token here instead: classic token
# with `repo` scope, or a fine-grained token with read-only "Contents" access.
# The proxy prefers the Device Flow token and falls back to this.
# GITHUB_PAT=ghp_replace_me

# Port the proxy listens on. Must match the "Proxy port" field in the extension popup.
PORT=7547
