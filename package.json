{
  "name": "diffhop",
  "version": "0.1.0",
  "description": "Chrome extension that redirects GitHub diff URLs to DiffsHub; private repos work via in-browser GitHub sign-in.",
  "private": true,
  "license": "MIT",
  "author": "James Andrews",
  "homepage": "https://github.com/JamesFTW/diffhop#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JamesFTW/diffhop.git"
  },
  "bugs": {
    "url": "https://github.com/JamesFTW/diffhop/issues"
  },
  "keywords": [
    "chrome-extension",
    "manifest-v3",
    "github",
    "diff",
    "diffshub",
    "code-review"
  ],
  "type": "module",
  "dependencies": {
    "diff": "^9.0.0"
  },
  "scripts": {
    "build": "node build.mjs",
    "build:watch": "node build.mjs --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:browser": "node build.mjs && node scripts/verify.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.42",
    "@types/diff": "^7.0.2",
    "@types/node": "^25.9.1",
    "esbuild": "^0.28.0",
    "jsdom": "^25.0.1",
    "playwright": "^1.60.0",
    "playwright-core": "^1.60.0",
    "prettier": "3.8.3",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  }
}
